{
    "manifest_version":  3,
    "name":  "Aegis Vault",
    "version":  "0.3.94",
    "key":  "",
    "minimum_chrome_version":  "106",
    "description":  "Kho mật khẩu local-first được mã hóa, hỗ trợ Firebase, OTP và autofill an toàn.",
    "permissions":  [
                        "storage",
                        "unlimitedStorage",
                        "activeTab",
                        "scripting",
                        "alarms",
                        "identity",
                        "favicon",
                        "downloads"
                    ],
    "host_permissions":  [
                             "https://identitytoolkit.googleapis.com/*",
                             "https://securetoken.googleapis.com/*",
                             "https://firestore.googleapis.com/*"
                         ],
    "background":  {
                       "service_worker":  "src/background.js",
                       "type":  "module"
                   },
    "icons":  {
                  "16":  "src/ui/logo-16.png",
                  "32":  "src/ui/logo-32.png",
                  "48":  "src/ui/logo-48.png",
                  "128":  "src/ui/logo-128.png"
              },
    "action":  {
                   "default_title":  "Aegis Vault",
                   "default_popup":  "src/ui/popup.html",
                   "default_icon":  {
                                        "16":  "src/ui/logo-16.png",
                                        "32":  "src/ui/logo-32.png",
                                        "48":  "src/ui/logo-48.png",
                                        "128":  "src/ui/logo-128.png"
                                    }
               },
    "options_page":  "src/ui/options.html",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://*/*",
                                                "http://localhost/*",
                                                "http://127.0.0.1/*"
                                            ],
                                "js":  [
                                           "src/content/suggestion-ranking.js",
                                           "src/content/content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "src/ui/logo-48.png"
                                                       ],
                                         "matches":  [
                                                         "https://*/*",
                                                         "http://localhost/*",
                                                         "http://127.0.0.1/*"
                                                     ]
                                     }
                                 ],
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027; object-src \u0027self\u0027"
                                },
    "oauth2":  {
                   "client_id":  "846050632481-abofreaom5d07e6fdi0tevorb554j01e.apps.googleusercontent.com",
                   "scopes":  [
                                  "openid",
                                  "email",
                                  "profile"
                              ]
               }
}