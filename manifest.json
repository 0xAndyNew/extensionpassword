{
    "manifest_version":  3,
    "name":  "Aegis Vault",
    "version":  "0.1.0",
    "description":  "Kho mật khẩu cục bộ được mã hóa, hỗ trợ lưu và gợi ý tài khoản an toàn.",
    "permissions":  [
                        "storage",
                        "activeTab",
                        "alarms",
                        "identity"
                    ],
    "host_permissions":  [
                             "http://*/*",
                             "https://*/*"
                         ],
    "background":  {
                       "service_worker":  "src/background.js",
                       "type":  "module"
                   },
    "icons": {
        "16": "src/ui/logo-16.png",
        "32": "src/ui/logo-32.png",
        "48": "src/ui/logo-48.png",
        "128": "src/ui/logo-128.png"
    },
    "action": {
        "default_title": "Aegis Vault",
        "default_popup": "src/ui/popup.html",
        "default_icon": {
            "16": "src/ui/logo-16.png",
            "32": "src/ui/logo-32.png",
            "48": "src/ui/logo-48.png",
            "128": "src/ui/logo-128.png"
        }
    },
    "options_page":  "src/ui/options.html",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "http://*/*",
                                                "https://*/*"
                                            ],
                                "js":  [
                                           "src/content/content.js"
                                       ],
                                "css":  [
                                            "src/content/content.css"
                                        ],
                                "run_at":  "document_idle"
                            }
                        ],
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027; object-src \u0027self\u0027"
                                },
    "oauth2":  {
                    "client_id": "187212798388-1vo287n30lkci4tro335dvq6scu9qvbu.apps.googleusercontent.com",
                   "scopes":  [
                                  "openid",
                                  "email",
                                  "profile",
                                  "https://www.googleapis.com/auth/drive.appdata"
                              ]
               }
}
